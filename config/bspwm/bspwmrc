#!/usr/bin/env sh
# ============================================================================
# bspwmrc - window manager bootstrap
# Apple Silicon / Asahi Fedora edition
# ============================================================================

# --- key bindings -----------------------------------------------------------
pgrep -x sxhkd >/dev/null || sxhkd &

# --- touchpad gestures (libinput) --------------------------------------------
if command -v libinput-gestures >/dev/null 2>&1; then
    pgrep -x libinput-gestures >/dev/null 2>&1 || libinput-gestures &
fi

# --- session daemons ---------------------------------------------------------
~/.config/bspwm/autostart.sh

# --- displays ----------------------------------------------------------------
bspc monitor -d I II III IV V VI VII VIII IX X

# --- visuals -----------------------------------------------------------------
xsetroot -cursor_name left_ptr

# Never blank/sleep the display while idle: DPMS wake hangs the Apple panel.
xset s off -dpms

# --- window management --------------------------------------------------------
bspc config border_width           2
bspc config window_gap             12
bspc config split_ratio            0.50
bspc config borderless_monocle     true
bspc config gapless_monocle        false
bspc config pointer_follows_focus  true
bspc config focus_follows_pointer  true

# CopyQ clipboard preview: tall narrow floating non-sticky window.
bspc rule -a copyq state=floating rectangle=500x750+1030+848 sticky=off

# --- resources / keys ---------------------------------------------------------
xrdb -merge ~/.Xresources &

# Apple Cmd key (keycode 207, unlocked from Hyper_L) -> Super_L, so that
# Super+{c,v,x,tab} feel like macOS Cmd+{c,v,x,tab}.
xmodmap ~/.Xmodmap

# --- Apple trackpad -----------------------------------------------------------
# Tap-to-click on the Apple MTP (multi-touch) trackpad.
xinput set-prop "Apple MTP multi-touch" "libinput Tapping Enabled" 1 2>/dev/null || true
# Adaptive acceleration profile with a smooth, slightly faster pointer.
xinput set-prop "Apple MTP multi-touch" "libinput Accel Profile Enabled" 0 1 0 2>/dev/null || true
xinput set-prop "Apple MTP multi-touch" "libinput Accel Speed" 0.65 2>/dev/null || true

# --- keyboard backlight (always on) -------------------------------------------
brightnessctl -q -d kbd_backlight s 255 2>/dev/null || true

# --- startup applications ------------------------------------------------------
QT_SCALE_FACTOR=0.75 copyq &