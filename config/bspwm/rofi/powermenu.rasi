/******* Power menu  *******/
configuration {
	font:			"Iosevka Nerd Font 20";
	show-icons:		false;
}

@import "~/.cache/wal/colors-rofi.rasi"
@theme "/dev/null"

window {
	border-radius:		7px;
	width:			20%;
	padding:		22px;
}

listview {
	columns:		5;
	lines:			2;
	cycle:			true;
	dynamic:		true;
	layout:			vertical;
	scrollbar:		true;
}

mainbox {
	children:		[ listview ];
	spacing:		2%;
	padding:		2% 1% 2% 1%;
}

element {
	orientation:		vertical;
	padding:		2% 0% 2% 0%;
}

element-text {
	expand:			true;
	horizontal-align:	0.5;
	vertical-align:		0.5;
	margin:			0.5% 0.5% -0.5% 0.5%;
}

element-text, element-icon {
	background-color:	inherit;
	text-color:		inherit;
}

element selected {
	background-color:	@accent;
	text-color:		@bg;
	border-radius:		6px;
}