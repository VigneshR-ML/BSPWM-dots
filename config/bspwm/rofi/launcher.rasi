/******* App launcher (rofi drun / window switcher)  *******/
configuration {
	modi:			"drun";
	font:			"Iosevka Nerd Font 22";
	show-icons:		true;
	display-drun:		"";
	drun-display-format:	"{name}";
	sidebar-mode:		false;
}

@import "~/.cache/wal/colors-rofi.rasi"
@theme "/dev/null"

window {
	border-radius:		7px;
	width:			40%;
	padding:		22px;
}

prompt {
	enabled:		true;
	padding:		0.5% 32px 0% -0.5%;
}

entry {
	placeholder:		"Search";
	placeholder-color:	@fg;
	expand:			true;
	padding:		0.15% 0% 0% 0%;
}

inputbar {
	children:		[ prompt, entry ];
	background-color:	@bg;
	expand:			false;
	border-radius:		6px;
	margin:			0%;
	padding:		10px;
}

listview {
	columns:		4;
	lines:			3;
	cycle:			false;
	dynamic:		true;
	layout:			vertical;
}

mainbox {
	children:		[ inputbar, listview ];
	spacing:		2%;
	padding:		2% 1% 2% 1%;
}

element {
	orientation:		vertical;
	padding:		2% 0% 2% 0%;
}

element-icon {
	size:			72px;
	horizontal-align:	0.5;
}

element-text {
	expand:			true;
	horizontal-align:	0.5;
	vertical-align:		0.5;
	margin:			0.5% 0.5% -0.5% 0.5%;
}

element-text, element-icon {
	background-color:	inherit;
	text-color:		inherit;
}

element selected {
	background-color:	@accent;
	text-color:		@bg;
	border-radius:		6px;
}