configuration {
	modi:				"window";
	font:				"Rubik 12";
	show-icons:                     true;
	icon-theme: 			"Reversal-dark";
	display-window: 		"";
	window-format:                  "{w}  ·  {c}  ({t})";
	sidebar-mode: 			false;
}

@theme "/dev/null"

* {
	bg:				#151515;
	fg:				#e8e8d3;
	accent:				#687363;
	button:				#1c1c1c;

	background-color:		@bg;
	text-color:			@fg;
}

window {
	border-radius:                  7px;
	width:			    	60%;
	padding: 			22px;
}

prompt {
	background-color:		@button;
	enabled:			true;
	padding:			0.5% 32px 0% -0.5%;
	font:				"Rubik 10";
}

entry {
    	placeholder:			"Switch window";
	background-color:               @button;
    	placeholder-color:              @fg;
    	expand:                         true;
    	padding:                        0.15% 0% 0% 0%;
}

inputbar {
	children:			[ prompt, entry ];
    	background-color:               @button;
    	expand:                         false;
    	border-radius:                  6px;
    	margin:                         0%;
    	padding:                        10px;
}

listview {
    	columns:                        1;
    	lines:	                        10;
    	cycle:                          false;
    	dynamic:                        true;
    	layout:                         vertical;
    	spacing:                        4px;
}

element {
    	padding:                        8px 14px;
    	border-radius:                  5px;
    	background-color:               transparent;
}

element selected {
    	background-color:               @accent;
    	text-color:                     #151515;
}

element-text {
    	horizontal-align:               0.5;
    	vertical-align:                 0.5;
}
