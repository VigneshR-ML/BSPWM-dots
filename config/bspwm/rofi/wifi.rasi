/******* Wi-Fi menu *******/
configuration {
	show-icons: false;
	font: "Iosevka Nerd Font 20";
}

@theme "/dev/null"

* {
	bg:      #151515;
	fg:      #e8e8d3;
	accent:  #616569;
	button:  #1c1c1c;

	background-color: @bg;
	text-color:       @fg;
}

window {
	transparency: "real";
	location: north;
	anchor: north;
	fullscreen: false;
	width: 28%;
	height: 42%;
	x-offset: 0;
	y-offset: 6%;
	border-radius: 10px;
	padding: 12px;
}

mainbox {
	children: [ "inputbar", "message", "listview" ];
	spacing: 2%;
}

inputbar {
	children: ["textbox-prompt-colon", "entry"];
	background-color: @button;
	border-radius: 6px;
	padding: 8px;
}

textbox-prompt-colon {
	str: "󰖩";
	text-color: @fg;
	padding: 0 6px 0 4px;
}

entry {
	placeholder: "Search";
	placeholder-color: @fg;
	text-color: @fg;
	cursor: "text";
}

message {
	padding: 6px 10px;
	background-color: @button;
	border-radius: 6px;
	text-color: @fg;
}

listview {
	columns: 1;
	lines: 8;
	spacing: 4px;
	scrollbar: true;
}

element {
	border-radius: 6px;
	padding: 6px;
}

element selected {
	background-color: @accent;
	text-color: #151515;
}

textbox {
	text-color: @fg;
	blink: true;
	markup: true;
}
error-message {
	background-color: @bg;
	text-color: @fg;
	padding: 15px;
}